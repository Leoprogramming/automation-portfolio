# Airtable API access (Personal Access Token from airtable.com/create/tokens)
AIRTABLE_PAT=

# Base and table IDs (find in Airtable URL: airtable.com/{baseId}/{tableId})
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Bearer token clients must send in Authorization header
# Generate a random one: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Port for the HTTP MCP server
PORT=3000
