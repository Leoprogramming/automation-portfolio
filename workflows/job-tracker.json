    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nconst existingSlugs = new Set(\n  allItems\n    .filter(item => typeof item.json.id === 'string' && item.json.id.startsWith('rec'))\n    .map(item => item.json.slug || item.json.fields?.slug)\n    .filter(Boolean)\n);\n\nconst STUDENT_RE = /werkstudent|working student|praktikum|ausbildung|internship|hilfst\u00e4tigkeit|student \\(college\\)/i;\nconst SENIORITY_RE = /\\bsenior\\b|\\bteam lead\\b|\\btech lead\\b|\\bprincipal\\b|\\bhead of\\b|manager\\b|leiter(in)?\\b|leitung\\b/i;\n\nreturn allItems\n  .filter(item => !(typeof item.json.id === 'string' && item.json.id.startsWith('rec')))\n  .filter(item => !existingSlugs.has(item.json.slug))\n  .map(item => {\n    const title = item.json.title || '';\n    const jobTypes = item.json.job_types || '';\n    let structurally_ineligible = false;\n    let pre_filter_reason = '';\n    const studentMatch = STUDENT_RE.exec(title) || STUDENT_RE.exec(jobTypes);\n    if (studentMatch) {\n      structurally_ineligible = true;\n      pre_filter_reason = 'filtered: ' + studentMatch[0].toLowerCase();\n    } else {\n      const seniorityMatch = SENIORITY_RE.exec(title);\n      if (seniorityMatch) {\n        structurally_ineligible = true;\n        pre_filter_reason = 'filtered: ' + seniorityMatch[0].toLowerCase();\n      }\n    }\n    return { json: { ...item.json, structurally_ineligible, pre_filter_reason } };\n  });\n"
      },
