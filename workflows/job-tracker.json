            {
              "name": "messages",
              "value": "={{ [{ role: 'user', content: 'Write a 2-paragraph cover letter opening (under 150 words) for this job application.\\n\\nPOSITION: ' + $json.title + ' at ' + $json.company + '\\nJOB TAGS: ' + $json.tags + '\\nWHY I FIT: ' + $json.match_reason + '\\n\\nABOUT ME (use only these facts \u2014 do not invent anything not stated here):\\n- Based in Berlin, available for full-time employment immediately\\n- Not a student \u2014 career transition back into tech after a 3-year break\\n- 2 years full-stack dev experience 2020\u20132022: JavaScript, TypeScript, React, Next.js, Node.js\\n- Now building AI workflow automation: n8n, LLM APIs (OpenAI, Anthropic), Docker, MCP servers\\n- Bootcamp trained (Le Wagon, IronHack), project management background\\n\\nCONSTRAINTS:\\n- Do not invent personal circumstances, study situations, availability constraints, or background details not listed above\\n- Do not mention balancing studies, university, or student life\\n- Do not add a greeting line or sign-off\\n- Output only the cover letter text' }] }}"
            }
          ]
        },
        "options": {}
      },
