    {
      "parameters": {
        "jsCode": "const anthropicResponse = $input.item.json;\nconst job = $('Parse Score').item.json;\n\nconst coverDraft = anthropicResponse.content && anthropicResponse.content[0]\n  ? anthropicResponse.content[0].text\n  : '';\n\nreturn {\n  json: {\n    ...job,\n    cover_draft: coverDraft\n  }\n};\n"
      },
