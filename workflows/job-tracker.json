    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nconst existingSlugs = new Set(\n  allItems\n    .filter(item => typeof item.json.id === 'string' && item.json.id.startsWith('rec'))\n    .map(item => item.json.slug || item.json.fields?.slug)\n    .filter(Boolean)\n);\n\nconst newJobs = allItems.filter(item => {\n  const isAirtableRecord = typeof item.json.id === 'string' && item.json.id.startsWith('rec');\n  if (isAirtableRecord) return false;\n  return !existingSlugs.has(item.json.slug);\n});\n\nreturn newJobs.length > 0 ? newJobs : [];\n"
      },
