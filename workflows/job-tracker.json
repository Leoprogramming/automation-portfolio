        "responses": {
          "values": [
            {
              "content": "=You are a job match scorer. Evaluate the posting below against the candidate profile and respond with JSON only — no markdown, no explanation.\n\nCANDIDATE PROFILE:\n- Skills: JavaScript, TypeScript, React, Next.js, Node.js, n8n workflow automation, LLM APIs (OpenAI/Anthropic), Docker, MCP servers\n- Level: Junior (2 years experience, 3-year hiatus, returning to tech)\n- Location: Berlin\n- Target: Junior AI Automation Engineer roles\n\nJOB POSTING:\nTitle: {{ $json.title }}\nCompany: {{ $json.company }}\nTags: {{ $json.tags }}\nDescription: {{ $json.description_raw.slice(0, 800) }}\n\nRespond with exactly this JSON structure:\n{\n  \"score\": <integer 1-10>,\n  \"matching_skills\": \"<comma-separated skills from the posting that match the candidate>\",\n  \"missing_skills\": \"<comma-separated skills the posting requires but the candidate lacks>\",\n  \"match_reason\": \"<one sentence explaining the score>\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [1344, -160],
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Score Job",
      "credentials": {
        "openAiApi": {
          "id": "5HzlFlmpAnyfFcYa",
          "name": "OpenAI - Email Triage"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.item.json.output[0].content[0].text;\nconst job = $('Code in JavaScript1').item.json;\n\nlet scored;\ntry {\n  scored = JSON.parse(text);\n} catch (e) {\n  scored = { score: 0, matching_skills: '', missing_skills: '', match_reason: 'JSON parse error' };\n}\n\nreturn {\n  json: {\n    ...job,\n    score: typeof scored.score === 'number' ? scored.score : 0,\n    matching_skills: scored.matching_skills || '',\n    missing_skills: scored.missing_skills || '',\n    match_reason: scored.match_reason || '',\n    cover_draft: ''\n  }\n};\n"
      },
