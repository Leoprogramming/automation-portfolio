    {
      "parameters": {
        "jsCode": "const jobs = $input.first().json.data;\n\nconst berlinJobs = jobs.filter(job =>\n  job.location && job.location.toLowerCase().includes('berlin')\n);\n\nreturn berlinJobs.map(job => ({\n  json: {\n    slug: job.slug,\n    title: job.title,\n    company: job.company_name,\n    location: job.location,\n    url: job.url,\n    description_raw: job.description.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim(),\n    tags: job.tags ? job.tags.join(', ') : '',\n    remote: job.remote,\n    job_types: job.job_types ? job.job_types.join(', ') : '',\n    created_at: new Date(job.created_at * 1000).toISOString().split('T')[0],\n    scraped_at: new Date().toISOString(),\n    source: 'Arbeitnow'\n  }\n}));\n"
      },
