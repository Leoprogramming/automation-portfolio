      "parameters": {
        "jsCode": "const text = $input.item.json.output[0].content[0].text;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  throw new Error(`OpenAI returned invalid JSON: ${text}`);\n}\n\nif (!parsed.urgency || !parsed.category || !parsed.summary) {\n  throw new Error(`OpenAI response missing required fields: ${text}`);\n}\n\nreturn { json: parsed };"
      },
