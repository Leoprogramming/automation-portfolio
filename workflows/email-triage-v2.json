              "content": "=You are an email triage assistant. Analyze the email below and respond with a JSON object only — no markdown, no explanation.\n\nEmail:\nSubject: {{ $('Gmail Trigger').item.json.Subject }}\nFrom: {{ $('Gmail Trigger').item.json.From }}\nBody: {{ $('Gmail Trigger').item.json.snippet }}\n\nRespond with exactly this structure:\n{\n  \"urgency\": \"high\" | \"medium\" | \"low\",\n  \"category\": \"action_required\" | \"fyi\" | \"newsletter\" | \"spam\",\n  \"summary\": \"one sentence summary of the email\",\n  \"suggested_action\": \"one sentence on what to do\"\n}"
